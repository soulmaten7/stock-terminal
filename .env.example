# 운종(雲從) · UNJONG — 환경변수 템플릿
# 사용법: cp .env.example .env.local 후 실제 값 채우기
# ⚠️ .env.local 은 절대 git push 하지 말 것 (.gitignore 처리됨)

# ============================================================
# Supabase (필수 — 운종 전용 프로젝트, 구 stock-platform 명)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ⚠️ SUPABASE_ACCESS_TOKEN — STEP 119 시크릿 노출 이력 (rotate 권장).
# 일반 개발에는 불필요 — Supabase MCP CLI 용 PAT. 비워두거나 새 토큰 발급.
SUPABASE_ACCESS_TOKEN=

# ============================================================
# 한국 시장 데이터 (KIS · DART · ECOS)
# ============================================================
# KIS Developer (한국투자증권 OpenAPI — 가격·차트·호가·체결·랭킹)
KIS_APP_KEY=YOUR_KIS_APP_KEY
KIS_APP_SECRET=YOUR_KIS_APP_SECRET
KIS_ACCOUNT_NO=YOUR_8_DIGIT_ACCOUNT
KIS_ACCOUNT_PROD=01
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_RATE_LIMIT_MS=100
# KIS 응답 캐시 TTL(ms). 동일 요청은 이 시간 동안 메모리 캐시에서 제공 (V6 ④ 캐시 안정화). 기본 15000
KIS_CACHE_TTL_MS=15000

# DART Open API (한국 공시)
DART_API_KEY=YOUR_DART_KEY

# 한국은행 ECOS (경제지표 — 선택)
ECOS_API_KEY=YOUR_ECOS_KEY

# ============================================================
# 미국 시장 데이터 (SEC EDGAR · FRED)
# ============================================================
# SEC EDGAR (8-K · 10-K · 공시) — User-Agent 필수
SEC_USER_AGENT=Unjong Research contact@yourdomain.com

# FRED (미국 경제지표 — 선택)
FRED_API_KEY=YOUR_FRED_KEY

# ============================================================
# 인증 — 카카오 OAuth (Supabase Auth Provider 연동)
# ============================================================
# 카카오 디벨로퍼스 → 내 애플리케이션 → REST API 키 + Client Secret
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET

# ============================================================
# 결제 — 토스페이먼츠 (광고주 결제 — Tier 1·2·3 인증 단계)
# ============================================================
TOSS_CLIENT_KEY=test_ck_YOUR_CLIENT
TOSS_SECRET_KEY=test_sk_YOUR_SECRET

# ============================================================
# AI 보조 (선택 — @운종AI 봇 등)
# ============================================================
OPENAI_API_KEY=sk-proj-YOUR_KEY
